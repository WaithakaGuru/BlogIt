generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())  @map("user_id")
  userName String @map("username") @unique
  email String @map("user_email") @unique
  password String @map("user_password")
  firstName String @map("first_name")
  lastName String @map("last_name")

  posts Posts[]

  @@map("users")
}

model Posts{
  id String @default(uuid()) @id @map("blogPost_id")
  title String @map("blog_title")
  description String @map("blog_info")
  userId String 
  
  blogAuthor User @relation(fields: [userId], references: [id])

  @@map("posts")
}