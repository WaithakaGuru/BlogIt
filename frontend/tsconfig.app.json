{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "erasableSyntaxOnly": true,
  },
  "include": ["src"]
}
